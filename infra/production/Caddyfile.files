{$FILES_SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		max_size 15MB
	}
	@minio path /minio*
	respond @minio 403
	reverse_proxy minio:9000
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "sandbox"
	}
	log {
		output stdout
		format console
	}
}
