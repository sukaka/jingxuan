{
	admin off
	auto_https off
}

:80 {
	header -Server
	redir {$PUBLIC_URL}{uri} 308
}

{$SITE_ADDRESS} {
	tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
	@health path /health
	handle @health {
		respond @health "ok" 200
	}
	@minio path /minio*
	handle @minio {
		respond @minio 403
	}
	@files_bucket path /{$FILES_BUCKET}/*
	handle @files_bucket {
		request_body {
			max_size 15MB
		}
		reverse_proxy minio:9000 {
			header_up -Cookie
		}
		header {
			-Server
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			Content-Security-Policy "sandbox"
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy web:8080
		header {
			-Server
			Strict-Transport-Security "max-age=31536000"
		}
	}
	log {
		output stdout
		format console
	}
}
