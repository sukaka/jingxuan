<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.whale.crm.customer.infrastructure.mapper.LegacyFieldMappingMapper">

  <resultMap id="LegacyFieldMappingMap" type="com.whale.crm.customer.domain.LegacyFieldMapping">
    <id property="id" column="id"/>
    <result property="tenantId" column="tenant_id"/>
    <result property="fieldKey" column="field_key"/>
    <result property="originalName" column="original_name"/>
    <result property="originalTable" column="original_table"/>
    <result property="targetField" column="target_field"/>
    <result property="sourceFormula" column="source_formula"/>
    <result property="sortOrder" column="sort_order"/>
    <result property="enabled" column="enabled"/>
  </resultMap>

  <select id="selectEnabled" resultMap="LegacyFieldMappingMap">
    SELECT id, tenant_id, field_key, original_name, original_table, target_field, source_formula,
           sort_order, enabled
    FROM crm_legacy_field_mapping
    WHERE tenant_id = #{tenantId} AND enabled = 1
    ORDER BY sort_order ASC, id ASC
  </select>

</mapper>
